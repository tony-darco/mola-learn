{
  "name": "mola",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mola/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @mola/db generate",
    "db:migrate": "pnpm --filter @mola/db migrate",
    "db:seed": "pnpm --filter @mola/db seed",
    "docker:up": "infra/docker-remote.sh up",
    "docker:down": "infra/docker-remote.sh down"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
