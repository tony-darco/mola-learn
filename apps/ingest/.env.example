# Points at YOUR database (mola_b) on the shared Postgres — never mola/mola_a/mola_c/mola_d.
DATABASE_URL=postgres://mola:REDACTED@192.168.1.17:5433/mola_b

# LocalStack S3 (three-bucket raw/safe/quarantine pattern, §12)
S3_ENDPOINT=http://192.168.1.17:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test
S3_BUCKET_RAW=mola-raw
S3_BUCKET_SAFE=mola-safe
S3_BUCKET_QUARANTINE=mola-quarantine

# Embedding model — mirrors packages/shared/src/embedding.ts (contract 3).
# Keep these three in sync with that file by hand; Python cannot import TS.
EMBED_MODEL=qwen3-embedding:0.6b
EMBED_DIM=1024
EMBED_VERSION=1

# Ollama — CPU-only for embeddings (num_gpu: 0 is set in code, not here).
OLLAMA_HOST=http://192.168.1.17:11434
# Chat model used only for pointer-file summary generation (§7).
MOLA_CHAT_MODEL=qwen3.6:27b

# Malware scanning — real clamd by default. Set INGEST_SCANNER=stub to use the
# always-clean stub (see ingest/scanner.py) when clamd isn't available locally.
INGEST_SCANNER=clamd
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# Policy
INGEST_MAX_BYTES=52428800
INGEST_USER_QUOTA_BYTES=524288000
INGEST_ALLOWED_KINDS=pdf,docx,md,txt

# Worker loop
INGEST_POLL_INTERVAL_SECONDS=2
INGEST_MAX_ATTEMPTS=5
INGEST_CHUNK_CHARS=1800
INGEST_CHUNK_OVERLAP_CHARS=200
