DATABASE_URL=postgres://mola:CHANGE_ME@192.168.1.17:5433/mola
OLLAMA_HOST=http://192.168.1.17:11434
# Chat model (BYOK replaces this in prod). Runs on the LAN GPU box, not this Mac;
# override for a machine that can serve it locally.
MOLA_CHAT_MODEL=qwen3.6:27b

# Inactivity timeout for a chat completion (ollama.ts) — default 120000 (2min).
# A single large structured tool-call argument (e.g. emit_quiz writing 10 full
# multiple_choice questions) can generate for minutes without any bytes
# reaching the client, which looks identical to a genuinely stalled host.
# Confirmed live: the default fired mid-generation on a 10-question quiz.
# Raise rather than remove — a truly stalled host should still time out.
OLLAMA_STALL_TIMEOUT_MS=300000

# Signs Auth.js session JWTs. Generate: openssl rand -base64 32
# REQUIRED — without it every sign-in and sign-up fails with MissingSecret.
AUTH_SECRET=

# AES-256 key encrypting BYOK API keys at rest. Generate: openssl rand -base64 32
# Required before a user can save a provider key in Settings.
MOLA_ENCRYPTION_KEY=

# S3 (LocalStack in dev)
S3_ENDPOINT=http://192.168.1.17:4566
S3_BUCKET_RAW=mola-raw
S3_BUCKET_SAFE=mola-safe
S3_BUCKET_QUARANTINE=mola-quarantine

# Google Calendar sync (§10 Tier 2) — optional. Unset means the feature reads
# as "not configured" in the UI rather than showing a broken connect button.
# Setup steps, scopes, and the exact redirect URI: GOOGLE-CALENDAR-SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Testing-only chat input/output logger (lib/debug/chat-log.ts) — writes JSONL
# to debug-logs/chat.jsonl (gitignored). OFF unless set to "1", and even then
# only logs for emails in MOLA_CHAT_DEBUG_LOG_EMAILS (default: alice@umbc.edu).
# NEVER enable in prod.
MOLA_CHAT_DEBUG_LOG=
MOLA_CHAT_DEBUG_LOG_EMAILS=alice@umbc.edu

# Testing-only agent activity logger (lib/debug/agent-log.ts) — logs every LLM
# call and tool call (top-level and nested sub-agent) as JSONL to
# debug-logs/agent.jsonl (gitignored). Same two-switch gate as the chat
# logger above: OFF unless set to "1", and even then only logs for emails in
# MOLA_AGENT_LOG_EMAILS (default: alice@umbc.edu). NEVER enable in prod.
MOLA_AGENT_LOG=
MOLA_AGENT_LOG_EMAILS=alice@umbc.edu
